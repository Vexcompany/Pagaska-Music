<?xml version="1.0" encoding="utf-8"?>
<!-- Bold ink outline and acid-yellow fill: Neo Brutalism widget base. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111111" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_primary_container" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>